# Canonical site URL (no trailing slash). Must match Vercel Domains.
# Correct:  https://ai.nomorevlad.vercel.app  (dot)
# Wrong:    https://ai-nomorevlad.vercel.app  (hyphen)
NEXT_PUBLIC_SITE_URL=https://ai.nomorevlad.vercel.app

# GA4 Measurement ID (optional). Analytics loads only after cookie OK.
# Example: NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID=
